# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE / Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# Project large data files (keep raw chunk downloads out of git)
data/raw/*.hdf5
data/raw/*.csv
data/sample/*.hdf5

# Keep sample CSV and readme tracked for easy inspection
!data/sample/*.csv
!data/raw/README.md
!data/raw/.gitkeep

# Checkpoint model files (large binary weights)
# Keep lightweight configs and metadata tracked
models/*.pt
models/*.pth
!models/metrics.json
!models/history.json

# Assets (keep generated plots tracked in Git)
!assets/*.png
!assets/*.svg

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
